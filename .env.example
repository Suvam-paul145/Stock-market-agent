# Copy to .env locally. The main CLI loads it; shell variables take precedence.
# Never paste keys into chat or research reports. Keep .env out of Git.
SEC_USER_AGENT=YourAppName your-contact-email
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# PostgreSQL foundation (separate setup; not needed for the local screen command).
STOCK_AGENT_DB_PROFILE=local
STOCK_AGENT_DATABASE_URL=
STOCK_AGENT_MIGRATION_URL=
